# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# Only needed for AI command interpretation. Everything else, including the
# safety gate, the dispenser and the ledger, works without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# serial | sim | auto   (auto falls back to the simulator when no board is found)
PILLBOT_BACKEND=sim

# Admin mode stays disabled unless this is set.
ADMIN_PIN=
